{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/github/relai/scripts/relai-watch-hook.sh --event=SessionStart"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/github/relai/scripts/relai-watch-hook.sh --event=Stop"
          }
        ]
      }
    ]
  }
}
