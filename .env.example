# Database — matches docker-compose.yml defaults
DATABASE_URL=postgresql://relai:relai@localhost:5433/relai

# API
API_PORT=3010
API_SECRET=changeme

# Routing — ANTHROPIC_API_KEY enables Claude fallback; omit for rules-only routing
ANTHROPIC_API_KEY=
ROUTING_MODEL=claude-haiku-4-5-20251001
TASK_POLL_MS=15000

# Agent identity — set these after registering an agent via the dashboard or CLI
AGENT_ID=
REPO_ID=

# MCP server transport: stdio (default) or http
TRANSPORT=stdio
MCP_PORT=3001

# Self-hosted orchestrator daemon (optional — only needed if not using the built-in scheduler)
ORCHESTRATOR_API_URL=http://localhost:3010
ORCHESTRATOR_API_SECRET=   # same as API_SECRET

# Where a human approves a `join` device request; the CLI is handed
# `<this>/device`. Set it only if a dashboard is actually running in front of
# this API — relai-cloud's dev server is http://localhost:4000. Left commented,
# device start still issues a code and simply omits the link, and the CLI says
# so rather than printing a URL that goes nowhere.
# RELAI_DASHBOARD_URL=http://localhost:4000

# Approve `join` requests through the API with the shared secret, for a
# self-hosted install running no dashboard.
# DEVICE_ALLOW_LEGACY_SECRET=true
